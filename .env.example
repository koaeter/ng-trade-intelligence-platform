APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5432/trade_intelligence
# Keycloak access-token validation (admin write routes remain disabled until verified)
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=trade-api
# Optional override; default is {KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=
# Optional Keycloak client ID whose resource_access roles are also mapped
KEYCLOAK_ROLE_CLIENT_ID=trade-api
